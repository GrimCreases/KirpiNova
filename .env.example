NEXT_PUBLIC_APP_URL=https://app.example.com
PORT=3000

# Configure these only in local `.env.local` or the Coolify secret environment.
# Never add real secrets to this example file.

DATABASE_URL=postgresql://kirpinova:replace-me@postgres:5432/kirpinova
DATABASE_POOL_MAX=10
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

NEXT_PUBLIC_PREVIEW_MODE=true
AUTH_DEV_RETURN_TOKENS=false

# SMTP verification email delivery.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-in-coolify
SMTP_PASSWORD=replace-in-coolify
SMTP_FROM=KirpiNova <no-reply@example.com>

# Private S3-compatible storage for client-encrypted attachments.
S3_ENDPOINT=https://s3.example.com
S3_REGION=auto
S3_BUCKET=kirpinova-private
S3_ACCESS_KEY_ID=replace-in-coolify
S3_SECRET_ACCESS_KEY=replace-in-coolify
S3_FORCE_PATH_STYLE=true
